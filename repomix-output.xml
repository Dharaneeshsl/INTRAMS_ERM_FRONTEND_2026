      const pdfUrl = URL.createObjectURL(pdfBlob);

      if (action === 'view') {
        const win = window.open(pdfUrl, '_blank');
        if (win) setTimeout(() => { try { win.document.title = filename; } catch {} }, 300);
      } else if (action === 'download') {
